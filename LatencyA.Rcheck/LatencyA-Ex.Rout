> flush(stderr()); flush(stdout())
> 
> ### Name: CoxPoly
> ### Title: This is a function to implement polynomial Cox regression for
> ###   latency analysis
> ### Aliases: CoxPoly
> 
> ### ** Examples
> 
> time_start <- "age_start"
> time_end <- "age_end"
> status <- "failure"
> exposure <- paste0("lag", 0:19)
> degree <- 3
> latency <- 20
> fit <- CoxPoly(sim_data, time_start, time_end, status, exposure, degree, latency)
> fit
Call:
coxph(formula = as.formula(model), data = regression_data, control = coxph.control(timefix = FALSE), 
    cluster = id)

         coef  exp(coef)   se(coef)  robust se      z      p
X0  4.090e-03  1.004e+00  1.153e-04  1.456e-04  28.09 <2e-16
X1  2.917e-03  1.003e+00  5.981e-05  7.266e-05  40.14 <2e-16
X2 -4.332e-04  9.996e-01  7.771e-06  9.402e-06 -46.08 <2e-16
X3  1.443e-05  1.000e+00  2.652e-07  3.206e-07  45.03 <2e-16

